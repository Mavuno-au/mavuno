# Supabase project (Project Settings → API). For local development, `pnpm db:start`
# prints these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the site, used for auth redirects, email links and share links.
# https://mavuno.au in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google" on the sign-in pages. Enable the Google provider in
# Supabase (Authentication → Providers) first.
NEXT_PUBLIC_AUTH_GOOGLE=false

# Optional: translation for posts. Any LibreTranslate-compatible API works, for
# example a self-hosted https://github.com/LibreTranslate/LibreTranslate.
# Without it, "Translate" opens the post in Google Translate instead.
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# Optional: lets the server cache translations. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a secret for calling /api/maintenance where pg_cron is unavailable.
MAINTENANCE_SECRET=

# Optional: Fathom Analytics site ID. Fathom is cookieless and counts page views
# plus two anonymous events (guest-visit, signup). Leave empty to load nothing.
NEXT_PUBLIC_FATHOM_SITE_ID=

# Optional: a Fathom API token (Settings → API) that can read the site above.
# With both set, admins see visits, pages and the sign-up rate under
# Operations → Traffic. Never expose it to the browser.
FATHOM_API_KEY=

# For `pnpm email:apply`: sign-in emails are sent from hello@mavuno.au through
# Resend (verified domain), and the script needs a Supabase personal access
# token (supabase.com/dashboard/account/tokens) to update the hosted project.
RESEND_API_KEY=
SUPABASE_ACCESS_TOKEN=

# For `pnpm db:push`: the session pooler connection string (Project Settings →
# Database → Connect), password included. Put the real value in .env.local only.
SUPABASE_DB_URL=
