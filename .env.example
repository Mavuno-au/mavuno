# Supabase project (Project Settings → API). For local development, `pnpm db:start`
# prints these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the site, used for auth redirects, email links and share links.
# https://mavuno.au in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google" on the sign-in pages. Enable the Google provider in
# Supabase (Authentication → Providers) first.
NEXT_PUBLIC_AUTH_GOOGLE=false

# Optional: translation for posts. Any LibreTranslate-compatible API works, for
# example a self-hosted https://github.com/LibreTranslate/LibreTranslate.
# Without it, "Translate" opens the post in Google Translate instead.
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# Needed for photo uploads: the server re-encodes every photo and stores it with
# this key. Without it, uploads are refused. It also caches translations. Never
# expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: checks posts from newer members with OpenAI's moderation model after
# they are created. Flagged posts go back to the review queue; nothing is ever
# rejected automatically. Needs SUPABASE_SERVICE_ROLE_KEY too.
OPENAI_API_KEY=

# Optional: a secret for calling /api/maintenance where pg_cron is unavailable.
MAINTENANCE_SECRET=

# Optional: Fathom Analytics site ID. Fathom is cookieless and counts page views
# plus two anonymous events (guest-visit, signup). Leave empty to load nothing.
NEXT_PUBLIC_FATHOM_SITE_ID=

# Optional: Google Analytics 4 measurement ID (G-…). Loads gtag with Google's
# advertising features off. Leave empty to load nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Search Console and Bing verification by meta tag (DNS verification
# at your registrar works too and covers every subdomain).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: IndexNow key (8–128 letters, numbers or dashes) and the secret Vercel's
# daily cron sends to /api/indexnow and /api/maintenance (which erases deleted photos).
INDEXNOW_KEY=
CRON_SECRET=

# For `pnpm email:apply`: sign-in emails are sent from hello@mavuno.au through
# Resend (verified domain), and the script needs a Supabase personal access
# token (supabase.com/dashboard/account/tokens) to update the hosted project.
RESEND_API_KEY=
SUPABASE_ACCESS_TOKEN=

# For `pnpm db:push`: the session pooler connection string (Project Settings →
# Database → Connect), password included. Put the real value in .env.local only.
SUPABASE_DB_URL=
