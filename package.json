{
  "name": "mavuno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "node --env-file-if-exists=.env.local scripts/db-push.mjs",
    "brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/brand-assets.mjs",
    "email:build": "node scripts/auth-email.mjs build",
    "email:apply": "node --env-file-if-exists=.env.local scripts/auth-email.mjs apply"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "geist": "1.8.1",
    "opentype.js": "1.3.4",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  }
}
