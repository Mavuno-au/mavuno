# Copy to .env.local (never committed). Expo builds these into the app; both
# Supabase values are public by design, as on the website.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where links to the website point (share links, pages the app doesn't have yet).
EXPO_PUBLIC_SITE_URL=https://mavuno.au
